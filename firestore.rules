rules_version = '2';

/* Reglas para la planilla de costos y la tienda pública.
   Cada cuenta de Google es dueña de su propio árbol en tiendas/{uid}:
   solo ella lee y escribe su gestión; el público únicamente ve el
   catálogo y los datos de contacto, y puede dejar un pedido. */
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /* pedido que deja un cliente desde la tienda: solo estos campos, con tamaños acotados */
    function pedidoValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['cliente', 'whatsapp', 'items', 'estado'])
        && d.keys().hasOnly(['cliente', 'whatsapp', 'instagram', 'items', 'envoltura', 'metodo', 'comuna',
                             'fecha', 'notas', 'total', 'estado', 'origen', 'nuevo', 'creado'])
        && d.cliente is string && d.cliente.size() > 0 && d.cliente.size() <= 120
        && d.whatsapp is string && d.whatsapp.size() > 0 && d.whatsapp.size() <= 40
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.estado == 'pendiente'
        && (!('origen' in d) || d.origen == 'tienda')
        && (!('nuevo' in d) || d.nuevo == true)
        && (!('instagram' in d) || (d.instagram is string && d.instagram.size() <= 60))
        && (!('comuna' in d) || (d.comuna is string && d.comuna.size() <= 200))
        && (!('notas' in d) || (d.notas is string && d.notas.size() <= 300))
        && (!('fecha' in d) || (d.fecha is string && d.fecha.size() <= 10));
    }

    /* dirección corta de una tienda: tienda.html?t=nombre → uid de su dueña */
    match /enlaces/{nombre} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /tiendas/{uid} {
      /* settings, moneda, impuesto: privados */
      allow read, write: if esDueno(uid);

      /* materiales e inventario (el stock vive dentro del material) */
      match /materiales/{docId} {
        allow read, write: if esDueno(uid);
      }

      /* productos con costos y márgenes: nunca salen de la cuenta */
      match /productos/{docId} {
        allow read, write: if esDueno(uid);
      }

      /* pedidos: cualquiera puede dejar uno desde la tienda,
         solo el dueño los lee, corrige o borra */
      match /pedidos/{docId} {
        allow read, update, delete: if esDueno(uid);
        allow create: if esDueno(uid) || pedidoValido();
      }

      /* cómo fue cambiando el costo de cada material: privado */
      match /historial/{docId} {
        allow read, write: if esDueno(uid);
      }

      /* compras de materiales para el precio promedio ponderado: privado */
      match /compras/{docId} {
        allow read, write: if esDueno(uid);
      }

      /* fotos de las flores, achicadas: las ve la tienda, las sube la dueña */
      match /fotos/{docId} {
        allow read: if true;
        allow write: if esDueno(uid);
      }

      /* catálogo publicado: lectura abierta, escritura del dueño */
      match /catalogo/{docId} {
        allow read: if true;
        allow write: if esDueno(uid);
      }

      /* perfil de la tienda y colores disponibles que ve el cliente */
      match /publico/{docId} {
        allow read: if true;
        allow write: if esDueno(uid);
      }
    }
  }
}
